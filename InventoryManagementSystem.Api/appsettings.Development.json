{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.AspNetCore.Authentication": "Information"
    }
  },
  "MongoDbSettings": {
    "ConnectionString": "YOUR_MONGODB_ATLAS_CONNECTION_STRING",
    "DatabaseName": "SmartInventoryDb"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_DEV_32_CHAR_JWT_SECRET_KEY",
    "Issuer": "SmartInventoryApi",
    "Audience": "SmartInventoryClient",
    "ExpiryInHours": 24
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5173",
      "http://localhost:5500",
      "http://127.0.0.1:5500"
    ]
  }
}
