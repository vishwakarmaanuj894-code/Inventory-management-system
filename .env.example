# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Frontend Deployment Config (Optional - points deployed frontend to your hosted ASP.NET Core API)
# Example: https://your-inventory-api.onrender.com/api
VITE_API_BASE_URL=""

# ASP.NET Core Backend & MongoDB Atlas Configuration (configure via environment variables or dotnet user-secrets)
MONGODB_CONNECTION_STRING="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=SmartInventoryCluster"
MONGODB_DATABASE_NAME="SmartInventoryDb"
JWT_SECRET="REPLACE_WITH_SECURE_32_PLUS_CHARACTER_JWT_SECRET"
CORS_ALLOWED_ORIGINS="https://ais-dev-ppd5wxdprdglcobafvyjm3-629029190277.asia-southeast1.run.app,https://ais-pre-ppd5wxdprdglcobafvyjm3-629029190277.asia-southeast1.run.app"

